# Copy this file to .env and fill in the blanks. Values already set in the environment win.

# ==========================================================================================
# 1. AI Foundry connection
# ==========================================================================================
LLM_BASE_URL=
LLM_CHAT_PATH=/foundry/chat/completions
LLM_MODEL=gpt-6-luna
# Sent as the X-PBAI-Helper-Id header.
HELPER_ID=
LLM_TIMEOUT_SECONDS=180
# false: do not check the internal gateway's TLS certificate (as in the 12-month project).
LLM_VERIFY_SSL=false
# Requests sent to Foundry at the same time, across all reviews. The rest wait their turn.
LLM_CONCURRENCY=9
# gpt-6-luna thinks before it answers and the thinking counts inside max_tokens,
# so this much is added to every step's answer size.
LLM_REASONING_EXTRA_TOKENS=4000
# Keep these off except when investigating a problem: they write transaction rows to the log or to disk.
LLM_LOG_ANSWERS=false
LLM_SAVE_BLOCKED_REQUESTS=false

# ==========================================================================================
# 2. The review
# ==========================================================================================
# Accounts with more rows than this are read in groups of about this size.
ROWS_PER_GROUP=300
# Days before and after a group that its reader also sees, and the most rows taken on each side.
NEIGHBOUR_DAYS=3
MAX_NEIGHBOUR_ROWS=60
# Suspected patterns checked per account (one Check call each).
MAX_PATTERNS_TO_CHECK=8
# Days around a suspected pattern's transactions that its Check call sees.
CHECK_DAYS=3
# Cash reporting limit, RM per account per day. Confirm the figure with compliance.
CASH_REPORT_LIMIT=25000
# The summary lists every day with transactions, up to this many days; beyond it, one line per week.
SUMMARY_MAX_DAYS=400
# How many repeated amounts and largest transactions the summary lists.
SUMMARY_LIST_SIZE=10
# Tool rounds the AI may use in one call, and rows one tool answer may show.
TOOL_MAX_ROUNDS=6
TOOL_MAX_ROWS=100
# Answer size (tokens) of each step, before LLM_REASONING_EXTRA_TOKENS is added.
READ_TOKENS=2000
SUMMARY_REVIEW_TOKENS=3000
COMBINE_TOKENS=3000
CHECK_TOKENS=1500
DECIDE_TOKENS=4000

# ==========================================================================================
# 3. The web page
# ==========================================================================================
# Accounts reviewed at the same time. Their AI calls share LLM_CONCURRENCY; lower both if Foundry
# returns HTTP 429 (too many requests).
BATCH_ACCOUNT_CONCURRENCY=3
# Most files in one upload, and finished batches kept for the results page (in memory only).
BATCH_MAX_FILES=20
BATCH_KEEP_RECENT=20
# "Read from folder": a server folder of account files (CSV, TSV or Parquet; one account per file,
# same columns as an upload). Blank hides the option.
ACCOUNT_FOLDER_PATH=

# ==========================================================================================
# 4. Files
# ==========================================================================================
# Mount on persistent storage in OpenShift: files inside the container are lost when it restarts.
REPORT_DIRECTORY=data/reports
LOG_DIRECTORY=data/logs
