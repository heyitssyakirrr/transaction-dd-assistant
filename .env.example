LLM_BASE_URL=https://llm-loader-askpbai.apps.bgndevocp101.pbb.pbg.my
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODEL=qwen2.5-vl-7b-instruct
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization
LLM_TIMEOUT_SECONDS=180
# The internal Qwen service has three available slots. This limit applies to
# every LLM request in this application, including synthesis and verification.
LLM_CONCURRENCY=3
CHUNK_SIZE=300
MAX_TARGET_CHUNKS=6
MAX_TARGET_CHUNKS_PER_REVIEW=2
MAX_RESPONSE_TOKENS=4000
# The model must not be treated as a final decision maker in this application.
REQUIRE_HUMAN_REVIEW=true