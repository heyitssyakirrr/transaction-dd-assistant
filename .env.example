# OpenAI-compatible endpoint exposed by your internal LLM loader.
# Example: http://qwen-loader.ai.svc.cluster.local:8000/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_CHAT_PATH=/chat/completions
LLM_MODEL=qwen2.5-vl-7b-instruct
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization
LLM_TIMEOUT_SECONDS=120

# Conservative prompt budget. The service automatically performs map/reduce
# analysis if compact transaction rows do not fit this budget.
MAX_PROMPT_TOKENS=18000
MAX_ROWS_PER_CHUNK=250
MAX_RESPONSE_TOKENS=2500

# The model must not be treated as a final decision maker in this application.
REQUIRE_HUMAN_REVIEW=true

